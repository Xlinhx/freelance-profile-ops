    "still:aicoding:cta": "remotion still src/remotion/index.ts AICodingComparison2026 --frame=1750 renders/drafts/ai-coding-comparison-2026/stills/aicoding-2026-cta.png",
    "render:googleio": "remotion render src/remotion/index.ts GoogleIO2026Gemini35Flash renders/drafts/google-io-2026-gemini-3.5-flash/video/google-io-2026.mp4 --color-space bt709",
