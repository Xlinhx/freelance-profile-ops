    "still:googleio:benchmarks": "remotion still src/remotion/index.ts GoogleIO2026Gemini35Flash --frame=360 renders/drafts/google-io-2026-gemini-3.5-flash/stills/google-io-benchmarks.png",
    "still:googleio:speed": "remotion still src/remotion/index.ts GoogleIO2026Gemini35Flash --frame=520 renders/drafts/google-io-2026-gemini-3.5-flash/stills/google-io-speed.png",
    "still:googleio:community": "remotion still src/remotion/index.ts GoogleIO2026Gemini35Flash --frame=700 renders/drafts/google-io-2026-gemini-3.5-flash/stills/google-io-community.png",
